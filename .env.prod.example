# HongShing production env — lives ONLY on the box at /opt/hongshing/.env (never committed).
# Generate secrets with: openssl rand -hex 32
# IMPORTANT: never regenerate DB_PASSWORD on an existing box — it must match the
# Postgres data volume or the DB becomes unreadable.

DB_PASSWORD=__generate_openssl_rand_hex_32__
SECRET_KEY=__generate_openssl_rand_hex_32__
OTP_PEPPER=__generate_openssl_rand_hex_16__

# ECR image ref written by deploy.sh (or set manually): <acct>.dkr.ecr.us-east-1.amazonaws.com/hongshing-backend:latest
BACKEND_IMAGE=

# Comma-separated allowed origins (the customer + admin + store hosts).
CORS_ORIGINS=https://hongshing.bridgewayinnovations.ca,https://admin.hongshing.bridgewayinnovations.ca,https://store.hongshing.bridgewayinnovations.ca

S3_BUCKET=hongshing-assets
SNS_ORIGINATION_NUMBER=+12368645995
OWNER_EMAIL=owner@hongshing.com

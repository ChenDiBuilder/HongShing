aws_region = "us-east-1"

environment = "production"

domain_name = "hongshing.vela.to"

secret_key = "change-me-generate-a-random-64-char-string"

otp_pepper = "change-me-generate-another-random-string"

owner_email = "owner@hongshing.com"

ecs_task_cpu    = 512
ecs_task_memory = 1024
ecs_desired_count = 1

database_instance_class    = "db.t4g.micro"
database_allocated_storage = 20
